{
  "name": "pocket-writer",
  "version": "0.1.0",
  "description": "Mumble a melody, get lyrics that fit it. Songwriting assistant with rhythm analysis and a rhyme finder.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/analysis.test.js && node test/phonetics.test.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "subtlex-word-frequencies": "^2.0.0",
    "word-list": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "Pocket Writer",
  "private": true,
  "build": {
    "appId": "com.pocketwriter.app",
    "productName": "Pocket Writer",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Pocket Writer listens to your mumbles and hums to work out the rhythm of each line."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
